# ==========================================
# JobOps AI - Environment Configuration
# ==========================================

# Application
APP_NAME=JobOps AI
APP_ENV=development
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# PostgreSQL
POSTGRES_DB=jobops
POSTGRES_USER=jobops
POSTGRES_PASSWORD=jobops_dev_password
POSTGRES_PORT=5432

# Database connection used by FastAPI inside Docker
DATABASE_URL=postgresql+psycopg://jobops:jobops_dev_password@postgres:5432/jobops

# Frontend
FRONTEND_PORT=8501

# n8n
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_before_production

# Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434